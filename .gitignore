# Allow-list: only the code is tracked. Exams, scans, keys, results and
# sample sheets stay local, including any new folders added later.
/*
!/.gitignore
!/README.md
!/pyproject.toml
!/omr_grader.py
!/gui.py
!/make_test_sheets.py
!/train_digits.py
!/omrgrader/
__pycache__/
*.egg-info/
!/docs/
# The example exam is synthetic and tracked; its generated output is not.
!/example/
/example/*
!/example/exam.tex
!/example/exam.aux
!/example/exam.pdf
!/example/gradebook.csv
